NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://remotemac:remotemac@localhost:5432/remotemac
# true for a managed Postgres that requires TLS (Supabase, Render's *external* DB URL). Leave
# unset/false for local Postgres or Render's internal URL between services in the same project.
DATABASE_SSL=

JWT_SECRET=change-me-to-a-random-32-plus-character-secret

TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

CORS_ORIGINS=
