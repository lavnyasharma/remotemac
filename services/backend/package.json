{
  "name": "@remote-mac/backend",
  "private": true,
  "version": "0.1.0",
  "description": "RemoteMac cloud backend — auth, device registry, pairing, and WebRTC signaling.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 dist",
    "lint": "eslint src",
    "migrate": "node-pg-migrate --migrations-dir migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@remote-mac/protocol": "*",
    "@remote-mac/types": "*",
    "argon2": "^0.41.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^5.9.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
