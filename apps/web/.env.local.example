# Copy to .env.local and fill in once you have a real GA4 property.
# Create one at https://analytics.google.com → Admin → Create Property → Data Streams → Web.
# Measurement ID looks like G-XXXXXXXXXX. Leave unset to keep analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The site's production domain, once one exists. Falls back to https://remotemac.app.
NEXT_PUBLIC_SITE_URL=
