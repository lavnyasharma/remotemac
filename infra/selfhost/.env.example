# Copy to .env and fill in. Never commit .env.

# Your domain pointing at the VM, or the free <PUBLIC_IP>.sslip.io (e.g. 34.123.45.67.sslip.io)
DOMAIN=
# VM external (static) IP and internal IP — GCP console → VM instances
PUBLIC_IP=
PRIVATE_IP=

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
TURN_USERNAME=remotemac
TURN_PASSWORD=
